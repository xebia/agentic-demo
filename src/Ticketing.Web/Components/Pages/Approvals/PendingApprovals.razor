@page "/approvals/pending"
@rendermode InteractiveServer
@attribute [Authorize(Roles = UserRoles.Approver)]
@using System.Text.RegularExpressions
@using Ticketing.Messaging.Abstractions

<PageTitle>Pending Approvals</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Pending Approvals</h1>
    <button class="btn btn-outline-secondary" @onclick="RefreshTickets" disabled="@_isLoading">
        <i class="bi bi-arrow-clockwise @(_isLoading ? "spin" : "")"></i> Refresh
    </button>
</div>

@if (_isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_cards == null || _cards.Count == 0)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle"></i> No pending approvals! All caught up!
    </div>
}
else
{
    <div class="mb-3 text-muted">
        @_cards.Count approval(s) pending
    </div>

    @foreach (var card in _cards)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="card-title">
                            <a href="@($"tickets/{card.Ticket.TicketId}")" class="text-decoration-none">
                                @card.Ticket.TicketId - @card.Ticket.Title
                            </a>
                        </h5>
                        <p class="card-text text-muted mb-2">
                            <i class="bi bi-person"></i> Requested by: @card.Ticket.RequestorDisplayName<br />
                            @if (card.Ticket.Category.HasValue)
                            {
                                <i class="bi bi-tag"></i> <span>Category: @card.Ticket.Category</span><br />
                            }
                            <i class="bi bi-clock"></i> Submitted: @card.Ticket.TimeSinceCreation
                        </p>

                        @if (card.Total is not null)
                        {
                            <div class="mb-2">
                                <span class="badge bg-primary fs-6">Total: $@card.Total.Value.ToString("N2")</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(card.Reasoning))
                        {
                            <div class="alert alert-info py-2 px-3 mb-2 small">
                                <strong>AI analysis:</strong> @card.Reasoning
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(card.Analysis))
                        {
                            <details class="small">
                                <summary class="text-muted">Quote details and full analysis</summary>
                                <pre class="bg-light p-2 mt-2 small" style="white-space: pre-wrap;">@card.Analysis</pre>
                            </details>
                        }
                    </div>
                    <div class="col-md-4 text-end">
                        <div class="d-flex flex-column gap-2">
                            <button class="btn btn-success" @onclick="() => ShowApproveConfirm(card.Ticket)">
                                <i class="bi bi-check-lg"></i> Approve
                            </button>
                            <button class="btn btn-danger" @onclick="() => ShowRejectModal(card.Ticket)">
                                <i class="bi bi-x-lg"></i> Reject
                            </button>
                            <a href="@($"tickets/{card.Ticket.TicketId}")" class="btn btn-outline-secondary">
                                <i class="bi bi-eye"></i> View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

<ConfirmModal @ref="_approveModal"
              Title="Approve Request"
              Message="@($"Approve purchase request {_selectedTicket?.TicketId}?")"
              ConfirmButtonText="Approve"
              ConfirmButtonClass="btn-success"
              OnConfirm="ApproveTicket" />

<ConfirmModal @ref="_rejectModal"
              Title="Reject Request"
              Message="@($"Reject purchase request {_selectedTicket?.TicketId}?")"
              ShowTextInput="true"
              InputLabel="Rejection Reason"
              InputPlaceholder="Enter the reason for rejecting this request..."
              RequireInput="true"
              ConfirmButtonText="Reject"
              ConfirmButtonClass="btn-danger"
              OnConfirm="RejectTicket" />

@code {
    [Inject]
    private IDataPortal<TicketList> _ticketListPortal { get; set; } = null!;

    [Inject]
    private IDataPortal<TicketEdit> _ticketEditPortal { get; set; } = null!;

    [Inject]
    private MockAuthenticationStateProvider _authProvider { get; set; } = null!;

    [Inject]
    private IEventPublisher _eventPublisher { get; set; } = null!;

    [Inject]
    private ILogger<PendingApprovals> _logger { get; set; } = null!;

    private record ApprovalCard(TicketInfo Ticket, decimal? Total, string? Reasoning, string? Analysis);

    private List<ApprovalCard>? _cards;
    private bool _isLoading = true;
    private ConfirmModal? _approveModal;
    private ConfirmModal? _rejectModal;
    private TicketInfo? _selectedTicket;

    protected override async Task OnInitializedAsync()
    {
        await RefreshTickets();
    }

    private async Task RefreshTickets()
    {
        _isLoading = true;
        try
        {
            var criteria = TicketListCriteria.PendingApproval();
            var tickets = await _ticketListPortal.FetchAsync(criteria);

            // Pull the full TicketEdit for each so we can surface AI reasoning and quote total
            // from TriageNotes — TicketInfo is intentionally lightweight and doesn't carry it.
            var detailFetches = tickets.Select(async t =>
            {
                try
                {
                    var edit = await _ticketEditPortal.FetchAsync(t.TicketId);
                    var (total, reasoning, analysis) = ParseAnalysis(edit.TriageNotes);
                    return new ApprovalCard(t, total, reasoning, analysis);
                }
                catch
                {
                    return new ApprovalCard(t, null, null, null);
                }
            });
            _cards = (await Task.WhenAll(detailFetches)).ToList();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error loading pending approvals");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static readonly Regex TotalRegex = new(@"^Total:\s*\$([\d,]+\.\d{2})", RegexOptions.Multiline);

    private static (decimal? Total, string? Reasoning, string? Analysis) ParseAnalysis(string? notes)
    {
        if (string.IsNullOrWhiteSpace(notes)) return (null, null, null);

        // Pull the most recent "--- Purchasing Analysis ---" block — there can be more than one
        // if the ticket bounced through fulfillment failures and came back.
        var marker = "--- Purchasing Analysis ---";
        var idx = notes.LastIndexOf(marker, StringComparison.Ordinal);
        if (idx < 0) return (null, null, null);

        var block = notes[(idx + marker.Length)..].TrimStart('\n', '\r', ' ');

        decimal? total = null;
        var totalMatch = TotalRegex.Match(block);
        if (totalMatch.Success && decimal.TryParse(totalMatch.Groups[1].Value.Replace(",", ""), out var parsedTotal))
        {
            total = parsedTotal;
        }

        // Reasoning is the first paragraph before "Quote Details:".
        string? reasoning = null;
        var quoteIdx = block.IndexOf("Quote Details:", StringComparison.Ordinal);
        if (quoteIdx > 0)
        {
            var firstPara = block[..quoteIdx].Trim();
            // Take just the first ~250 chars for the inline summary.
            reasoning = firstPara.Length > 250 ? firstPara[..250] + "…" : firstPara;
        }

        return (total, reasoning, block);
    }

    private void ShowApproveConfirm(TicketInfo ticket)
    {
        _selectedTicket = ticket;
        _approveModal?.Show();
    }

    private void ShowRejectModal(TicketInfo ticket)
    {
        _selectedTicket = ticket;
        _rejectModal?.Show();
    }

    private async Task ApproveTicket(string? _)
    {
        if (_selectedTicket == null) return;
        var ticketId = _selectedTicket.TicketId;
        var title = _selectedTicket.Title;

        try
        {
            var ticket = await _ticketEditPortal.FetchAsync(ticketId);
            ticket.Approve();
            await _ticketEditPortal.UpdateAsync(ticket);

            await PublishApprovalEventAsync(TicketEventTypes.TicketApproved, ticketId, title, "Approved");
            await RefreshTickets();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error approving ticket {TicketId}", ticketId);
        }
    }

    private async Task RejectTicket(string? reason)
    {
        if (_selectedTicket == null || string.IsNullOrEmpty(reason)) return;
        var ticketId = _selectedTicket.TicketId;
        var title = _selectedTicket.Title;

        try
        {
            var ticket = await _ticketEditPortal.FetchAsync(ticketId);
            ticket.Reject(reason);
            await _ticketEditPortal.UpdateAsync(ticket);

            await PublishApprovalEventAsync(TicketEventTypes.TicketRejected, ticketId, title, "Rejected");
            await RefreshTickets();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error rejecting ticket {TicketId}", ticketId);
        }
    }

    private async Task PublishApprovalEventAsync(string eventType, string ticketId, string title, string status)
    {
        try
        {
            await _eventPublisher.PublishAsync(new TicketEvent
            {
                EventType = eventType,
                Payload = new TicketEventPayload
                {
                    TicketId = ticketId,
                    Title = title,
                    Status = status,
                    AssignedQueue = "Purchasing",
                    ChangedBy = _authProvider.CurrentUser.DisplayName
                }
            });
        }
        catch (Exception ex)
        {
            // The status change has already been persisted via CSLA; surface the publish
            // failure but don't roll back the user-visible action.
            _logger.LogError(ex, "Failed to publish {EventType} for ticket {TicketId}", eventType, ticketId);
        }
    }
}

<style>
    .spin {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
</style>
